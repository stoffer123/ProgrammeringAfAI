@inject DishSuggestionService Service

<MudText Typo="Typo.h5" GutterBottom="true">Retforslag</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Indtast fem retter, du normalt spiser til aftensmad, og få ti nye forslag.
</MudText>

<form @onsubmit="SubmitAsync">
    <MudStack Spacing="2">
        @for (int i = 0; i < _dishes.Length; i++)
        {
            int index = i; // nødvendig: ellers binder alle felter til den sidste værdi af i
            <MudTextField @bind-Value="_dishes[index]" Label="@($"Ret {index + 1}")"
                          Variant="Variant.Outlined" Immediate="true" Disabled="@_loading" />
        }

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@_loading" StartIcon="@Icons.Material.Filled.Restaurant">
            @if (_loading)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                <span>Finder forslag...</span>
            }
            else
            {
                <span>Find forslag</span>
            }
        </MudButton>
    </MudStack>
</form>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}

@if (_suggestions is not null)
{
    <MudText Typo="Typo.h6" Class="mt-6 mb-3">Ti retter du måske også vil kunne lide</MudText>

    <MudGrid>
        @for (int i = 0; i < _suggestions.Count; i++)
        {
            var s = _suggestions[i];
            int number = i + 1;
            <MudItem xs="12" md="6">
                <MudCard Outlined="true" Style="height: 100%">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1"><b>@number. @s.Name</b></MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@s.Reason</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private readonly string[] _dishes = new string[5];
    private List<DishSuggestion>? _suggestions;
    private string? _error;
    private bool _loading;

    private async Task SubmitAsync()
    {
        var dishes = _dishes.Select(d => d?.Trim() ?? "").ToList();

        if (dishes.Any(string.IsNullOrWhiteSpace))
        {
            _error = "Udfyld alle fem retter.";
            return;
        }
        if (dishes.Distinct(StringComparer.OrdinalIgnoreCase).Count() < 5)
        {
            _error = "Retterne skal være forskellige.";
            return;
        }

        _loading = true;
        _error = null;
        _suggestions = null;

        try
        {
            _suggestions = await Service.GetSuggestionsAsync(dishes);
        }
        catch (Exception ex)
        {
            _error = $"Noget gik galt: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}