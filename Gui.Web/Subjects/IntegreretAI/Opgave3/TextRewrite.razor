@inject TextRewriteService Service

<MudText Typo="Typo.h5" GutterBottom="true">Omskrivning til målgrupper</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Indsæt en kort tekst, og få den omskrevet til tre forskellige målgrupper.
</MudText>

<MudTextField @bind-Value="_text" Label="Tekst" Variant="Variant.Outlined"
              Lines="6" AutoGrow="true" MaxLength="2000" Counter="2000"
              Immediate="true" Disabled="@_loading" />

<MudGrid Class="mt-2">
    @for (int i = 0; i < _audiences.Length; i++)
    {
        int index = i;
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_audiences[index]" Label="@($"Målgruppe {index + 1}")"
                          Variant="Variant.Outlined" Immediate="true" Disabled="@_loading" />
        </MudItem>
    }
</MudGrid>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
           StartIcon="@Icons.Material.Filled.AutoFixHigh"
           Disabled="@_loading" OnClick="SubmitAsync">
    @if (_loading)
    {
        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
        <span>Omskriver...</span>
    }
    else
    {
        <span>Omskriv</span>
    }
</MudButton>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}

@if (_versions is not null)
{
    <MudGrid Class="mt-4">
        @foreach (var v in _versions)
        {
            <MudItem xs="12" md="4">
                <MudCard Outlined="true" Style="height: 100%">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@v.Audience</MudText>
                            <MudText Typo="Typo.caption">@WordCount(v.Text) ord</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Style="white-space: pre-line">@v.Text</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private string _text = "";
    private readonly string[] _audiences = ["Børn", "Fagpersoner", "Almindelige borgere"];
    private List<RewrittenText>? _versions;
    private string? _error;
    private bool _loading;

    private static int WordCount(string text) =>
        text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private async Task SubmitAsync()
    {
        var audiences = _audiences.Select(a => a?.Trim() ?? "").ToList();

        if (string.IsNullOrWhiteSpace(_text))
        {
            _error = "Indsæt en tekst.";
            return;
        }
        if (audiences.Any(string.IsNullOrWhiteSpace))
        {
            _error = "Udfyld alle tre målgrupper.";
            return;
        }
        if (audiences.Distinct(StringComparer.OrdinalIgnoreCase).Count() < 3)
        {
            _error = "Målgrupperne skal være forskellige.";
            return;
        }

        _loading = true;
        _error = null;
        _versions = null;

        try
        {
            _versions = await Service.RewriteAsync(_text.Trim(), audiences);
        }
        catch (Exception ex)
        {
            _error = $"Noget gik galt: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}